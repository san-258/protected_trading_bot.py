    def get_latest_bars(self, account_id: str) -> Dict:
        """Fetch latest 1-minute bars for all symbols"""
        account_data = self.accounts.get(account_id)
        if not account_data:
            return {}
        
        api = account_data['api']
        bars_data = {}
        
        try:
            for symbol in self.symbols:
                try:
                    bars = api.get_bars(
                        symbol,
                        timeframe='1Min',
                        limit=1,
                        adjustment='raw',
                        feed='iex'
                    ).df
                    
                    if not bars.empty:
                        latest = bars.iloc[-1]
                        bars_data[symbol] = {
                            'timestamp': latest.name,
                            'open': float(latest['open']),
                            'high': float(latest['high']),
                            'low': float(latest['low']),
                            'close': float(latest['close']),
                            'volume': int(latest['volume'])
                        }
                        
                except Exception as e:
                    # Silently skip symbols with errors
                    continue
            
            return bars_data
            
        except Exception as e:
            print(f"⚠️  Error fetching bars for account {account_id}: {e}")
            return {}
    
    def place_order(self, account_id: str, symbol: str, qty: int, 
                   side: str, price: float) -> Optional[str]:
        """Place order with Alpaca"""
        account_data = self.accounts.get(account_id)
        if not account_data:
            return None
        
        api = account_data['api']
        
        try:
            if qty <= 0:
                print(f"⚠️  Invalid quantity for {symbol}: {qty}")
                return None
            
            # Submit market order
            order = api.submit_order(
                symbol=symbol,
                qty=qty,
                side=side,
                type='market',
                time_in_force='day'
            )
            
            # Log order
            print(f"\n💰 ORDER EXECUTED")
            print(f"   Account: {account_id}")
            print(f"   Action: {side.upper()}")
            print(f"   Symbol: {symbol}")
            print(f"   Quantity: {qty} shares")
            print(f"   Price: ~${price:.2f}")
            print(f"   Order ID: {order.id}\n")
            
            # Update statistics
            self.stats['total_trades'] += 1
            account_data['stats']['trades'] += 1
            
            if side == 'buy':
                self.stats['entries_executed'] += 1
            else:
                self.stats['exits_executed'] += 1
            
            # Send notification
            self.notifier.send(
                f"📈 {side.upper()} {qty} {symbol} @ ${price:.2f} (Account: {account_id})"
            )
            
            return order.id
            
        except Exception as e:
            print(f"❌ Order failed for {symbol}: {e}")
            self.notifier.send(f"❌ Order failed: {symbol} {side} ({e})", priority="high")
            return None
    
    def update_position(self, account_id: str, symbol: str, qty: int, 
                       price: float, side: str):
        """Update internal position tracking"""
        account_data = self.accounts.get(account_id)
        if not account_data:
            return
        
        position = account_data['positions'][symbol]
        
        if side == 'buy':
            # Opening position
            position['qty'] = qty
            position['entry_price'] = price
            position['entry_time'] = datetime.now()
            position['highest_price'] = price
            position['type'] = 'LONG'
            
            print(f"✅ POSITION OPENED")
            print(f"   Symbol: {symbol}")
            print(f"   Quantity: {qty} shares")
            print(f"   Entry Price: ${price:.2f}")
            print(f"   Total Cost: ${qty * price:,.2f}\n")
            
        elif side == 'sell':
            # Closing position
            if position['qty'] > 0:
                pnl = position['qty'] * (price - position['entry_price'])
                pnl_pct = (price - position['entry_price']) / position['entry_price'] * 100
                
                print(f"✅ POSITION CLOSED")
                print(f"   Symbol: {symbol}")
                print(f"   Quantity: {position['qty']} shares")
                print(f"   Entry: ${position['entry_price']:.2f}")
                print(f"   Exit: ${price:.2f}")
                print(f"   P&L: ${pnl:+,.2f} ({pnl_pct:+.2f}%)\n")
                
                # Update statistics
                account_data['stats']['total_pnl'] += pnl
                if pnl > 0:
                    account_data['stats']['wins'] += 1
                else:
                    account_data['stats']['losses'] += 1
                
                # Send notification
                self.notifier.send(
                    f"💵 {symbol} CLOSED: ${pnl:+,.2f} ({pnl_pct:+.2f}%)"
                )
            
            # Reset position
            position['qty'] = 0
            position['entry_price'] = 0
            position['entry_time'] = None
            position['highest_price'] = 0
            position['type'] = None
    
    def process_bar(self, account_id: str, symbol: str, bar_data: Dict):
        """Process incoming bar data - core trading logic"""
        account_data = self.accounts.get(account_id)
        if not account_data:
            return
        
        try:
            # Update activity tracking
            self.last_activity_time = datetime.now()
            self.stats['total_bars'] += 1
            account_data['stats']['bars'] += 1
            
            # Store bar data
            account_data['symbol_data'][symbol].append(bar_data)
            
            # STEP 1: Check for pending signal from previous bar
            # (Enter on NEXT candle open after signal)
            pending = self.signal_manager.get_pending_signal(symbol)
            position = account_data['positions'][symbol]
            
            if pending and position['qty'] == 0:
                entry_price = bar_data['open']  # ← Enter at OPEN of new candle
                qty = pending['qty']
                signal = pending['signal']
                
                print(f"\n🎯 EXECUTING PENDING ENTRY")
                print(f"   Symbol: {symbol}")
                print(f"   Entry Price: ${entry_price:.2f} (candle open)")
                print(f"   Signal Price: ${pending['detection_price']:.2f} (previous candle)")
                print(f"   Slippage: ${abs(entry_price - pending['detection_price']):.2f}")
                
                if signal == 1:  # Long entry
                    order_id = self.place_order(account_id, symbol, qty, 'buy', entry_price)
                    if order_id:
                        self.update_position(account_id, symbol, qty, entry_price, 'buy')
                
                elif signal == -1:  # Short entry (if enabled)
                    print(f"   SHORT signal - not implemented in this version")
                
                self.signal_manager.clear_pending_signal(symbol)
                return
            
            # STEP 2: Check exit conditions for existing positions
            if position['qty'] != 0:
                exit_reason = self.risk_manager.check_exit_conditions(
                    position,
                    bar_data['close']
                )
                
                if exit_reason:
                    print(f"\n🚪 EXIT SIGNAL: {symbol} - {exit_reason}")
                    qty = abs(position['qty'])
                    order_id = self.place_order(account_id, symbol, qty, 'sell', bar_data['close'])
                    if order_id:
                        self.update_position(account_id, symbol, 0, bar_data['close'], 'sell')
                return
            
            # STEP 3: Look for new entry signals (only if no position and market open)
            if position['qty'] == 0 and self.is_market_hours():
                # Calculate indicators
                indicators = self.indicator_calculator.calculate_indicators(
                    account_data['symbol_data'][symbol]
                )
                
                if not indicators:
                    return
                
                # Generate signal using protected entry logic
                signal = self.signal_manager.generate_signal(symbol, indicators)
                
                if signal != 0:
                    # Update statistics
                    self.stats['total_signals'] += 1
                    account_data['stats']['signals'] += 1
                    
                    if signal == 1:
                        self.stats['long_signals'] += 1
                    else:
                        self.stats['short_signals'] += 1
                    
                    # Get buying power
                    try:
                        account = api.get_account()
                        buying_power = float(account.buying_power)
                    except:
                        buying_power = 100000  # Fallback
                    
                    # Calculate position size
                    qty = self.risk_manager.calculate_position_size(
                        bar_data['close'],
                        indicators['ATR'],
                        buying_power
                    )
                    
                    if qty > 0:
                        # Register signal for next candle entry
                        self.signal_manager.register_pending_signal(
                            symbol, signal, qty, bar_data['close'], indicators
                        )
                    else:
                        print(f"⚠️  Position size calculated as 0 for {symbol}")
                        
        except Exception as e:
            print(f"⚠️  Error processing bar for {symbol}: {e}")
    
