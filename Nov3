class IndicatorCalculator:
    """
    Calculate technical indicators.
    
    SAFE TO MODIFY:
    - Add new indicators
    - Optimize calculations
    - Add caching
    
    DO NOT REMOVE:
    - Required indicators (check ProtectedEntryLogic.get_required_indicators())
    """
    
    def __init__(self, max_bars=200):
        self.max_bars = max_bars
    
    def calculate_indicators(self, bars_data: deque) -> Optional[Dict]:
        """
        Calculate all indicators.
        
        REQUIRED indicators must always be calculated.
        Additional indicators can be added freely.
        """
        if len(bars_data) < 50:
            return None
            
        bars_list = list(bars_data)
        df = pd.DataFrame(bars_list)
        
        if df.empty or len(df) < 50:
            return None
        
        try:
            # ═══════════════════════════════════════════════════════════
            # REQUIRED INDICATORS - DO NOT REMOVE
            # ═══════════════════════════════════════════════════════════
            
            # EMAs (5, 10, 35 are REQUIRED)
            df['EMA_5'] = df['close'].ewm(span=5, adjust=False).mean()
            df['EMA_10'] = df['close'].ewm(span=10, adjust=False).mean()
            df['EMA_35'] = df['close'].ewm(span=35, adjust=False).mean()
            
            # MACD (REQUIRED)
            exp1 = df['close'].ewm(span=12, adjust=False).mean()
            exp2 = df['close'].ewm(span=26, adjust=False).mean()
            df['MACD'] = exp1 - exp2
            df['MACD_signal'] = df['MACD'].ewm(span=9, adjust=False).mean()
            
            # Volume (REQUIRED)
            df['volume_sma'] = df['volume'].rolling(20).mean()
            df['volume_ratio'] = df['volume'] / df['volume_sma'].replace(0, 1)
            
            # ═══════════════════════════════════════════════════════════
            # OPTIONAL INDICATORS - Safe to add/modify/remove
            # ═══════════════════════════════════════════════════════════
            
            # Additional EMAs
            df['EMA_50'] = df['close'].ewm(span=50, adjust=False).mean()
            df['EMA_200'] = df['close'].ewm(span=200, adjust=False).mean()
            
            # MACD Histogram
            df['MACD_histogram'] = df['MACD'] - df['MACD_signal']
            
            # RSI
            delta = df['close'].diff()
            gain = (delta.where(delta > 0, 0)).rolling(14).mean()
            loss = (-delta.where(delta < 0, 0)).rolling(14).mean()
            rs = gain / loss.replace(0, 0.0001)
            df['RSI'] = 100 - (100 / (1 + rs))
            
            # ATR
            df['high_low'] = df['high'] - df['low']
            df['high_close'] = abs(df['high'] - df['close'].shift())
            df['low_close'] = abs(df['low'] - df['close'].shift())
            df['tr'] = df[['high_low', 'high_close', 'low_close']].max(axis=1)
            df['ATR'] = df['tr'].rolling(14).mean()
            
            # Bollinger Bands
            df['BB_middle'] = df['close'].rolling(20).mean()
            df['BB_std'] = df['close'].rolling(20).std()
            df['BB_upper'] = df['BB_middle'] + (df['BB_std'] * 2)
            df['BB_lower'] = df['BB_middle'] - (df['BB_std'] * 2)
            
            latest = df.iloc[-1]
            prev = df.iloc[-2] if len(df) > 1 else latest
            
            # Return all indicators
            return {
                # ══════ REQUIRED - DO NOT REMOVE ══════
                'close': latest['close'],
                'EMA_5': latest['EMA_5'],
                'EMA_10': latest['EMA_10'],
                'EMA_35': latest['EMA_35'],
                'prev_EMA_5': prev['EMA_5'],
                'prev_EMA_10': prev['EMA_10'],
                'MACD': latest['MACD'],
                'MACD_signal': latest['MACD_signal'],
                'prev_MACD': prev['MACD'],
                'prev_MACD_signal': prev['MACD_signal'],
                'volume_ratio': latest['volume_ratio'],
                
                # ══════ OPTIONAL - Safe to add/remove ══════
                'EMA_50': latest['EMA_50'],
                'EMA_200': latest['EMA_200'],
                'MACD_histogram': latest['MACD_histogram'],
                'RSI': latest['RSI'],
                'ATR': latest['ATR'],
                'BB_upper': latest['BB_upper'],
                'BB_middle': latest['BB_middle'],
                'BB_lower': latest['BB_lower'],
                'high': latest['high'],
                'low': latest['low'],
                'open': latest['open'],
                'volume': latest['volume']
            }
            
        except Exception as e:
            print(f"⚠️  Error calculating indicators: {e}")
            return None


class RiskManager:
    """
    Risk management and position sizing.
    
    SAFE TO MODIFY:
    - All parameters (stop loss, take profit, etc.)
    - Position sizing logic
    - Exit conditions
    - Risk calculations
    """
    
    def __init__(self, initial_capital=250000):
        self.initial_capital = initial_capital
        
        # ══════ ALL PARAMETERS SAFE TO MODIFY ══════
        self.risk_per_trade = 0.01  # 1% risk per trade
        self.max_position_size = initial_capital * 0.15  # 15% max position
        self.stop_loss = 0.008  # 0.8% stop loss
        self.take_profit_1 = 0.015  # 1.5% first target
        self.take_profit_2 = 0.025  # 2.5% second target
        self.trailing_stop = 0.005  # 0.5% trailing stop
        self.min_profit_for_trailing = 0.005  # 0.5% profit before trailing activates
    
    def calculate_position_size(self, current_price: float, atr: float, 
                                buying_power: float) -> int:
        """
        Calculate position size based on risk management.
        Safe to modify this logic.
        """
        try:
            # Calculate risk amount
            risk_amount = min(
                buying_power * self.risk_per_trade,
                self.max_position_size * self.risk_per_trade
            )
            
            # Calculate stop distance (use ATR or fixed percentage, whichever is larger)
            stop_distance = max(atr * 2, current_price * self.stop_loss)
            
            # Position size based on risk
            position_size = int(risk_amount / stop_distance)
            
            # Apply maximum position size constraint
            max_shares = int(self.max_position_size / current_price)
            position_size = min(position_size, max_shares)
            
            # Apply buying power constraint (use 95% to leave buffer)
            max_affordable = int(buying_power * 0.95 / current_price)
            position_size = min(position_size, max_affordable)
            
            return max(position_size, 0)
            
        except Exception as e:
            print(f"⚠️  Error calculating position size: {e}")
            return 0
    
    def check_exit_conditions(self, position: Dict, current_price: float) -> Optional[str]:
        """
        Check if position should be exited.
        Safe to modify and add new exit conditions.
        """
        if position['qty'] == 0:
            return None
        
        try:
            if position['type'] == 'LONG':
                # Update highest price for trailing stop
                if current_price > position['highest_price']:
                    position['highest_price'] = current_price
                
                # Calculate P&L percentage
                entry_price = position['entry_price']
                if entry_price == 0:
                    return None
                    
                pnl_pct = (current_price - entry_price) / entry_price
                
                # Stop Loss
                if pnl_pct <= -self.stop_loss:
                    return "Stop Loss"
                
                # Take Profit targets
                if pnl_pct >= self.take_profit_2:
                    return "Take Profit 2"
                elif pnl_pct >= self.take_profit_1:
                    return "Take Profit 1"
                
                # Trailing Stop (only if in profit)
                if pnl_pct > self.min_profit_for_trailing:
                    trailing_stop_price = position['highest_price'] * (1 - self.trailing_stop)
                    if current_price < trailing_stop_price:
                        return "Trailing Stop"
            
            elif position['type'] == 'SHORT':
                # Update lowest price for trailing stop
                if current_price < position['highest_price'] or position['highest_price'] == 0:
                    position['highest_price'] = current_price
                
                # Calculate P&L percentage for short
                entry_price = position['entry_price']
                if entry_price == 0:
                    return None
                    
                pnl_pct = (entry_price - current_price) / entry_price
                
                # Stop Loss
                if pnl_pct <= -self.stop_loss:
                    return "Stop Loss"
                
                # Take Profit targets
                if pnl_pct >= self.take_profit_2:
                    return "Take Profit 2"
                elif pnl_pct >= self.take_profit_1:
                    return "Take Profit 1"
                
                # Trailing Stop (only if in profit)
                if pnl_pct > self.min_profit_for_trailing:
                    trailing_stop_price = position['highest_price'] * (1 + self.trailing_stop)
                    if current_price > trailing_stop_price:
                        return "Trailing Stop"
            
            return None
            
        except Exception as e:
            print(f"⚠️  Error checking exit conditions: {e}")
            return None


class SignalManager:
    """
    Manages signal generation using protected entry logic.
    
    DO NOT MODIFY:
    - Core signal generation logic
    - Calls to ProtectedEntryLogic
    
    SAFE TO MODIFY:
    - Pending signal storage
    - Signal logging
    - Signal filtering
    """
    
    def __init__(self):
        self.entry_logic = ProtectedEntryLogic()
        self.pending_signals = {}
        
        # Verify integrity on initialization
        try:
            self.entry_logic.verify_integrity()
            info = self.entry_logic.get_info()
            print(f"✅ Core strategy verified: {info['strategy_name']} v{info['version']}")
        except ValueError as e:
            print(f"🚨 INTEGRITY CHECK FAILED:\n{e}")
            raise
    
    def generate_signal(self, symbol: str, indicators: Dict) -> int:
        """
        Generate trading signal using protected entry logic.
        
        DO NOT MODIFY THIS METHOD - it enforces the core strategy.
        
        Returns:
            1 = Long signal
           -1 = Short signal
            0 = No signal
        """
        try:
            # Verify all required indicators are present
            required = self.entry_logic.get_required_indicators()
            missing = [ind for ind in required if ind not in indicators]
            
            if missing:
                print(f"⚠️  {symbol}: Missing required indicators: {missing}")
                return 0
            
            # Check LONG entry signal
            is_valid_long, reason = self.entry_logic.validate_long_entry(indicators)
            if is_valid_long:
                print(f"\n🎯 VALID LONG SIGNAL DETECTED: {symbol}")
                print(f"   {reason}")
                print(f"   Current Price: ${indicators['close']:.2f}")
                print(f"   RSI: {indicators.get('RSI', 0):.1f}")
                print(f"   Will enter on next candle open\n")
                return 1
            
            # Check SHORT entry signal
            is_valid_short, reason = self.entry_logic.validate_short_entry(indicators)
            if is_valid_short:
                print(f"\n🎯 VALID SHORT SIGNAL DETECTED: {symbol}")
                print(f"   {reason}")
                print(f"   Current Price: ${indicators['close']:.2f}")
                print(f"   RSI: {indicators.get('RSI', 0):.1f}")
                print(f"   Will enter on next candle open\n")
                return -1
            
            return 0
            
        except Exception as e:
            print(f"⚠️  Error generating signal for {symbol}: {e}")
            return 0
    
    def register_pending_signal(self, symbol: str, signal: int, qty: int, 
                               price: float, indicators: Dict):
        """Register signal to execute on next candle - Safe to modify"""
        self.pending_signals[symbol] = {
            'signal': signal,
            'qty': qty,
            'detection_price': price,
            'timestamp': datetime.now(),
            'indicators': indicators
        }
        signal_type = "LONG" if signal == 1 else "SHORT"
        print(f"📊 {signal_type} signal registered for {symbol}")
        print(f"   Detection price: ${price:.2f}")
        print(f"   Will enter {qty} shares on next candle open")
    
    def get_pending_signal(self, symbol: str) -> Optional[Dict]:
        """Get pending signal for symbol - Safe to modify"""
        return self.pending_signals.get(symbol)
    
    def clear_pending_signal(self, symbol: str):
        """Clear pending signal after execution - Safe to modify"""
        if symbol in self.pending_signals:
            del self.pending_signals[symbol]


