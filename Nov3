    def start(self):
        """Start the protected trading bot"""
        print("\n🚀 STARTING PROTECTED TRADING BOT")
        print("="*70)
        
        # Setup all accounts
        print("\nConnecting to accounts...")
        successful_accounts = 0
        
        for i, config in enumerate(self.account_configs):
            print(f"\n[{i+1}/{len(self.account_configs)}] Connecting...")
            account_id = self.setup_account(config)
            if account_id:
                successful_accounts += 1
        
        if successful_accounts == 0:
            print("\n❌ ERROR: No accounts connected successfully")
            self.notifier.send("❌ Bot failed to start - No accounts connected", priority="high")
            return
        
        print(f"\n✅ Successfully connected {successful_accounts} account(s)")
        
        # Sync existing positions
        print("\nSyncing existing positions...")
        for account_id, account_data in self.accounts.items():
            try:
                api = account_data['api']
                positions = api.list_positions()
                
                if positions:
                    print(f"\n  Account: {account_id}")
                    for pos in positions:
                        symbol = pos.symbol
                        if symbol in self.symbols:
                            qty = int(float(pos.qty))
                            entry_price = float(pos.avg_entry_price)
                            current_price = float(pos.current_price)
                            
                            account_data['positions'][symbol].update({
                                'qty': qty,
                                'entry_price': entry_price,
                                'entry_time': datetime.now(),
                                'highest_price': current_price,
                                'type': 'LONG' if qty > 0 else 'SHORT'
                            })
                            
                            pnl_pct = (current_price - entry_price) / entry_price * 100
                            print(f"    {symbol}: {qty} shares @ ${entry_price:.2f} (P&L: {pnl_pct:+.2f}%)")
                else:
                    print(f"\n  Account: {account_id} - No existing positions")
                    
            except Exception as e:
                print(f"  Position sync failed for {account_id}: {e}")
        
        # Start status monitoring thread
        self.is_running = True
        status_thread = threading.Thread(target=self.print_status, daemon=True)
        status_thread.start()
        
        # Send startup notification
        account_ids = ', '.join(self.accounts.keys())
        strategy_info = self.signal_manager.entry_logic.get_info()
        
        self.notifier.send(
            f"🤖 Protected Trading Bot Started\n"
            f"Strategy: {strategy_info['strategy_name']} v{strategy_info['version']}\n"
            f"Accounts: {account_ids}\n"
            f"Symbols: {', '.join(self.symbols)}"
        )
        
        print("\n✅ Bot is now running")
        print("📊 Real-time dashboard will appear in 3 seconds...")
        time.sleep(3)
        
        # Main polling loop
        print("\n📡 Starting market data polling (60-second intervals)...\n")
        
        while self.is_running:
            try:
                # Poll each account
                for account_id, account_data in self.accounts.items():
                    # Fetch latest bars
                    bars_data = self.get_latest_bars(account_id)
                    
                    if bars_data:
                        # Process each symbol
                        for symbol, bar_data in bars_data.items():
                            self.process_bar(account_id, symbol, bar_data)
                    else:
                        # No data received - connection issue?
                        pass
                
                # Wait 60 seconds before next poll
                time.sleep(60)
                
            except KeyboardInterrupt:
                self.is_running = False
                print("\n\n🛑 Bot stopped by user")
                self.notifier.send("🛑 Bot stopped - Manual shutdown")
                break
                
            except Exception as e:
                print(f"\n⚠️  Polling error: {e}")
                print("Retrying in 30 seconds...")
                time.sleep(30)


