        macd_already_bullish = indicators['prev_MACD'] > indicators['prev_MACD_signal']
        if not macd_already_bullish:
            return False, "MACD was not already bullish before EMA cross"
        reasons.append("✓ MACD was already bullish (pre-confirmed)")
        
        # CONDITION 3: Price above EMA 35 (trend filter)
        price_above_35 = indicators['close'] > indicators['EMA_35']
        if not price_above_35:
            return False, f"Price ${indicators['close']:.2f} below EMA35 ${indicators['EMA_35']:.2f}"
        reasons.append(f"✓ Price above EMA 35 (${indicators['close']:.2f} > ${indicators['EMA_35']:.2f})")
        
